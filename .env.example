# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (public, safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Error monitoring (Sentry). Leave empty to disable.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Build-time only (source map upload). Set in CI/Vercel, never NEXT_PUBLIC_.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
